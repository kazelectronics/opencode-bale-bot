# Advanced environment overrides.
#
# The normal setup path is `opencode-bale-bot setup`, which writes
#   ${XDG_CONFIG_HOME:-~/.config}/opencode-bale-bot/config.json
# with mode 0600. Environment variables are optional and override that file;
# command-line flags override both. Do not commit real secrets.
#
# For a container or a secret manager, export these instead of writing a file.
# Prefer the *_FILE forms: they keep secrets out of `ps` and the environment.

# --- Bale -------------------------------------------------------------------
# Required. The bot token, or a file containing it.
# BALE_BOT_TOKEN=
# BALE_BOT_TOKEN_FILE=

# Required. The only Bale user allowed to control the bot (see /id).
# BALE_ALLOWED_USER_ID=

# Optional. `/bot` is appended automatically when missing.
# BALE_API_BASE_URL=https://tapi.bale.ai/bot
# BALE_POLL_TIMEOUT_SEC=30
# BALE_POLL_LIMIT=50

# --- OpenCode ---------------------------------------------------------------
# Required. `providerID/modelID`; the server default may be region-blocked.
# OPENCODE_MODEL=

# Required. A direct secret, a file, or the default service file.
# OPENCODE_PASSWORD=
# OPENCODE_PASSWORD_FILE=
# The default is ~/.config/opencode/service.json.

# OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_USERNAME=opencode
# OPENCODE_AGENT=build
# OPENCODE_TIMEOUT_MS=60000

# Optional server lifecycle hooks for /opencode_start and /opencode_stop.
# OPENCODE_START_COMMAND=
# OPENCODE_STOP_COMMAND=
# OPENCODE_AUTO_RESTART=false
# OPENCODE_HEALTH_CHECK_MS=30000
# OPENCODE_RESTART_FAILURES=2
# OPENCODE_RESTART_COOLDOWN_MS=300000
# OPENCODE_RESTART_MAX_COOLDOWN_MS=3600000
# OPENCODE_RESTART_TIMEOUT_MS=60000

# Directory where new sessions run. Defaults to $HOME.
# PROJECT_DIRECTORY=

# --- Paths ------------------------------------------------------------------
# XDG roots are honoured. These override individual files when needed.
# OPENCODE_BALE_CONFIG=
# OPENCODE_BALE_STATE_DIR=
# OPENCODE_BALE_DATA_DIR=
# BRIDGE_DB_PATH=
# BRIDGE_LOCK_PATH=
# BRIDGE_ATTACHMENT_DIR=
# BRIDGE_LOG_FILE=

# --- Bridge ----------------------------------------------------------------
# BRIDGE_EDIT_INTERVAL_MS=1500
# BRIDGE_LIVE_TEXT_LIMIT=3900
# BRIDGE_DELIVERY=queue
# BRIDGE_SESSION_PREFIX=Bale
# BRIDGE_ATTACHMENT_MAX_MB=15
# BRIDGE_ATTACHMENT_TTL_HOURS=24
# Loopback health endpoint (port 0 disables).
# BRIDGE_HEALTH_HOST=127.0.0.1
# BRIDGE_HEALTH_PORT=4097
# Scheduled task sweep interval and per-run timeout.
# BRIDGE_TASK_TICK_MS=15000
# BRIDGE_TASK_TIMEOUT_MIN=30
# Log rotation.
# BRIDGE_LOG_MAX_MB=10
# BRIDGE_LOG_MAX_FILES=5
# LOG_LEVEL=info
